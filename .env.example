# ====================================================================
# VEAYOS Homoeopathy ClinicalOS - Environment Configuration Template
# ====================================================================
# Copy this file to '.env' in the project root:
#   cp .env.example .env
#
# Note: You can either set these environment variables here OR paste
# your Firebase Web App configuration directly into the Settings view
# in the application UI (Settings > Firebase Cloud Database).
# ====================================================================

# --- Firebase Cloud Firestore Configuration ---
# Obtain from Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=AIzaSyExampleKey1234567890abcdefghijklm
VITE_FIREBASE_AUTH_DOMAIN=your-clinic-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-clinic-id
VITE_FIREBASE_STORAGE_BUCKET=your-clinic-id.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=102938475612
VITE_FIREBASE_APP_ID=1:102938475612:web:abcdef1234567890

# --- Google Gemini AI API Configuration ---
# Used for Kentian Totality & Materia Medica homoeopathy repertorization
VITE_GEMINI_API_KEY=
VITE_GEMINI_MODEL=gemini-2.5-flash

# --- Aisensy WhatsApp Gateway Configuration ---
# Used for instant prescription delivery and follow-up appointment reminders
VITE_AISENSY_API_KEY=
VITE_AISENSY_SENDER_NUMBER=+919811234567
VITE_AISENSY_CAMPAIGN_NAME=prescription_share_v1
VITE_AISENSY_REMINDER_CAMPAIGN=followup_reminder_v1
