# VEAYOS Homoeopathy ClinicalOS - Backend Environment Variables
PORT=5000
NODE_ENV=production

# Production CORS Allowed Origins (comma-separated list, or * in dev)
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,https://veayos-clinicalos-pwa.web.app
FRONTEND_URL=http://localhost:5173

# JWT Secret for Session Authentication
JWT_SECRET=veayos-super-secret-jwt-key-for-homoeopathy-clinicalos-2025

# Strict Whitelist Accounts (comma-separated, Dr. V. P. Dixit & Dr. Ved Prakash)
WHITELIST_ACCOUNTS=vpdixit75@gmail.com,ved@veayos.com

# Server-Side Google Gemini API Key (for Repertory Analysis Proxy)
# When set here, frontend calls never expose your Gemini key
GEMINI_API_KEY=

# Aisensy WhatsApp Gateway API Key & Campaign Settings
AISENSY_API_KEY=
AISENSY_SENDER_NUMBER=+919811234567
AISENSY_PRESCRIPTION_CAMPAIGN=prescription_share_v1
AISENSY_REMINDER_CAMPAIGN=followup_reminder_v1

# Firebase Admin SDK Configuration (Optional Cloud Firestore Server Persistence)
FIREBASE_SERVICE_ACCOUNT_PATH=
FIREBASE_SERVICE_ACCOUNT_JSON=
